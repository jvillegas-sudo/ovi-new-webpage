# OVI Ventures – Environment Variables Template
#
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to version control.
#
# Prefix public (browser-accessible) variables with NEXT_PUBLIC_

# ─── App ───────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="OVI Ventures"
NEXT_PUBLIC_APP_DESCRIPTION="Industrial biotechnology and cleaning technology"

# ─── Analytics ─────────────────────────────────────────────────────────────────
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_VERCEL_ANALYTICS_ID=

# ─── Email / Contact ───────────────────────────────────────────────────────────
# RESEND_API_KEY=
# CONTACT_EMAIL=

# ─── Three.js / Assets ─────────────────────────────────────────────────────────
# NEXT_PUBLIC_CDN_URL=https://cdn.oviventures.com
